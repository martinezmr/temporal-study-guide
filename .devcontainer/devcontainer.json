{
  "name": "temporal-30-days",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-temporal.sh",
  "forwardPorts": [8233, 7233],
  "portsAttributes": {
    "8233": { "label": "Temporal UI", "onAutoForward": "openBrowser" },
    "7233": { "label": "Temporal gRPC", "onAutoForward": "silent" }
  },
  "containerEnv": { "DEVICE_MODE": "mock" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
