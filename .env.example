# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Devices: "live" talks to cEOS over eAPI, "mock" uses tests/fixtures (Codespaces, unit tests)
DEVICE_MODE=live
DEVICE_USERNAME=admin
DEVICE_PASSWORD=admin
# name=host pairs; use mgmt IPs, or jump-host port forwards on macOS
DEVICE_HOSTS=bos-rtr-01=172.20.20.2,bos-acc-01=172.20.20.3,nyc-rtr-01=172.20.20.4,nyc-acc-01=172.20.20.5

# Source of truth (Day 7+)
NAUTOBOT_URL=http://localhost:8000
NAUTOBOT_TOKEN=

# AI week (Day 25+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
